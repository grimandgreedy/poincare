# Poincare language smoke test

# scalars and math builtins
a = 3
b = sqrt(16) + pow(2, 3)
print("a =", a, "  b =", b)
print("pi ~", pi, "  cos(0) =", cos(0))

# functions and a signature
r2 : R^2 -> R
r2(x, y) = x^2 + y^2
print("r2(3, 4) =", r2(3, 4))

# lists and higher-order functions
xs = [1, 2, 3, 4, 5]
print("sum =", sum(xs), "  mean =", mean(xs))
print("squares =", map(xs, n => n * n))
print("evens =", filter(xs, n => n % 2 == 0))

# recursion and control flow
fact(n) = if n <= 1 { 1 } else { n * fact(n - 1) }
print("5! =", fact(5))

for i in 1..3 {
  print("row", i)
}

# composition and pipe
inc(x) = x + 1
double(x) = x * 2
print("(double . inc)(10) =", (double . inc)(10))
print("10 |> inc |> double =", 10 |> inc |> double)

# a CSV table from a literal string
data = csv("x,y\n10,20\n30,40")
print("columns:", columns(data))
print("y column:", column(data, "y"))

# a graph value, emitted as an output
amp = 2
g = graph()
g = add_plot(g, surface(z = amp * (x^2 + y^2), x = -3..3, y = -3..3))
g = add_plot(g, curve(y = sin(x), x = -6..6))
emit(g)

# the final expression is the cell value
fact(6)
